//Question1 
class Solution {
    public int myAtoi(String s) {
        int i = 0;
        int n = s.length();

        while (i < n && s.charAt(i) == ' ')
            i++;

        int sign = 1;

        if (i < n && s.charAt(i) == '-') {
            sign = -1;
            i++;
        } else if (i < n && s.charAt(i) == '+') {
            i++;
        }

        long num = 0;

        while (i < n && Character.isDigit(s.charAt(i))) {
            num = num * 10 + (s.charAt(i) - '0');

            if (sign == 1 && num > 2147483647)
                return 2147483647;

            if (sign == -1 && -num < -2147483648L)
                return -2147483648;

            i++;
        }

        return (int)(sign * num);
    }
}

