class Solution {
    public void findLargestOddSubstring(String num) {
        for (int i = num.length() - 1; i >= 0; i--) {
            char c = num.charAt(i);

            if (c == '1' || c == '3' || c == '5' ||
                c == '7' || c == '9') {
                System.out.println(num.substring(0, i + 1));
                return;
            }
        }

        System.out.println("-1");
    }
}

